{
  "name": "@umituz/web-live",
  "version": "1.4.0",
  "description": "Live rooms for web apps — polling-based signaling, WebRTC peer mesh, presence roster, media device management and segmented composite recording, transport-agnostic so any backend can host it.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./signaling": "./src/signaling/index.ts",
    "./webrtc": "./src/webrtc/index.ts",
    "./presence": "./src/presence/index.ts",
    "./room": "./src/room/index.ts",
    "./media": "./src/media/index.ts",
    "./recorder": "./src/recorder/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./presentation": "./src/presentation/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test",
    "version:patch": "npm version patch -m 'chore: release v%s'",
    "version:minor": "npm version minor -m 'chore: release v%s'",
    "version:major": "npm version major -m 'chore: release v%s'"
  },
  "peerDependencies": {
    "react": ">=18.0.0 || ^19.0.0",
    "react-dom": ">=18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.32.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.5"
  },
  "keywords": [
    "live",
    "webrtc",
    "live-room",
    "video-call",
    "voice-room",
    "presence",
    "signaling",
    "media-recorder",
    "screen-share",
    "realtime",
    "react",
    "typescript"
  ],
  "author": "umituz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umituz/web-live.git"
  },
  "bugs": {
    "url": "https://github.com/umituz/web-live/issues"
  },
  "homepage": "https://github.com/umituz/web-live#readme"
}
